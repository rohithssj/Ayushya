# Example environment file for AYUSHYA

# OpenRouter API Key for grounded LLM inference (Server-side only)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Sarvam AI API Key for direct Indian language translation & transliteration (Server-side only)
SARVAM_API_KEY=your_sarvam_api_key_here


# LLM Configuration
LLM_MODEL=mistralai/mistral-small-24b-instruct-2501
LLM_FALLBACK_MODELS=meta-llama/llama-3.3-70b-instruct,nvidia/nemotron-3-super-120b-a12b
LLM_TIMEOUT_SECONDS=25
